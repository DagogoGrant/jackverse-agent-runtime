# ==============================================================================
# JackVerse Agent Runtime Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Primary LLM Provider Configuration
# ------------------------------------------------------------------------------
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4.1-mini

# Optional LLM Tuning Parameters
# LLM_TIMEOUT_SECONDS=30.0
# LLM_MAX_RETRIES=2
# LLM_TEMPERATURE=0.0
# LLM_EXTRA_HEADERS={"X-Custom-Header":"custom-value"}

# ------------------------------------------------------------------------------
# Example: OpenRouter (OpenAI-compatible)
# ------------------------------------------------------------------------------
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your_openrouter_api_key
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# ------------------------------------------------------------------------------
# Example: Local Ollama (Local OpenAI-compatible /v1 endpoint, no key required)
# ------------------------------------------------------------------------------
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:14b

# For Docker reaching local Ollama on host machine (macOS/Windows/Linux):
# LLM_BASE_URL=http://host.docker.internal:11434/v1

# ------------------------------------------------------------------------------
# Example: Local vLLM / LM Studio
# ------------------------------------------------------------------------------
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=none
# LLM_MODEL=Qwen/Qwen2.5-14B-Instruct

# ------------------------------------------------------------------------------
# General Runtime Settings
# ------------------------------------------------------------------------------
HARNESS_LOG_LEVEL=INFO
# AGENT_HARNESS_CONFIG=config/config.yaml
