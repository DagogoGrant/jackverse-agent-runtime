# ==============================================================================
# Caseworker API - Service Environment Configuration (Phase 5.3.3.1)
# ==============================================================================
# Instructions:
# 1. Copy this template to .env.caseworker-api.local:
#    cp .env.caseworker-api.example .env.caseworker-api.local
# 2. Fill in your genuine Google OAuth Client credentials from Google Cloud Console.
# 3. Generate high-entropy encryption and operator signing keys:
#    python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# 4. NEVER commit .env.caseworker-api.local or private keys to version control.
# ==============================================================================

# Google OAuth 2.0 Web Application Credentials
CASEWORKER_GMAIL_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
CASEWORKER_GMAIL_CLIENT_SECRET=your_google_client_secret

# Exact Authorized Redirect URI registered in Google Cloud Console
# Must match exactly: scheme (https), host (localhost), port (3443), path (/api/v1/auth/google/callback)
CASEWORKER_GMAIL_REDIRECT_URI=https://localhost:3443/api/v1/auth/google/callback

# Symmetric encryption key for storing OAuth access and refresh tokens.
# TokenCipher derives a 32-byte base64url Fernet key from this value via SHA-256.
# Must be at least 32 characters of high-entropy randomness.
CASEWORKER_ENCRYPTION_KEY=replace_with_at_least_32_characters_of_random_entropy_here

# HMAC-SHA256 signing secret for operator bearer tokens and browser sessions.
# Must be at least 32 characters of high-entropy randomness.
CASEWORKER_OPERATOR_SECRET=replace_with_at_least_32_characters_of_random_entropy_here

# Governed Execution and Safety Gates (DO NOT MODIFY: Real sending is disabled)
CASEWORKER_DEV_AUTH=false
CASEWORKER_REAL_EXECUTION_ENABLED=false
CASEWORKER_GMAIL_EXECUTION_ENABLED=false
